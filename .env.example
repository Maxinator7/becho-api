PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://becho_user:becho_password@localhost:5433/becho_db?schema=public"

# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"

# REQUIRED in production (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET="change-me-dev-only-access-secret-0000000000"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret-000000000"

# Interval for background jobs (listing/offer expiry), in minutes
JOBS_INTERVAL_MINUTES=15
# Show OTP codes in API responses instead of SMS (default: on unless NODE_ENV=production)
# EXPOSE_DEV_OTP=true
# Max /auth requests per IP per 15 minutes
AUTH_RATE_LIMIT=30

# Media storage: local (disk, dev only) or r2 (Cloudflare R2)
STORAGE_DRIVER=local
# PUBLIC_API_URL=http://localhost:4000
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=becho-media
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Limits
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_VIDEO_SECONDS=60
MEDIA_MAX_IMAGES_PER_LISTING=10
MEDIA_MAX_VIDEOS_PER_LISTING=1
MEDIA_UPLOADS_PER_DAY=100
LISTINGS_PER_DAY=5
