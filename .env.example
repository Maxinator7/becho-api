PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://becho_user:becho_password@localhost:5433/becho_db?schema=public"

# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"

# REQUIRED in production (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET="change-me-dev-only-access-secret-0000000000"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret-000000000"

# Interval for background jobs (listing/offer expiry), in minutes
JOBS_INTERVAL_MINUTES=15
